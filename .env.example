# ==== 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会上传 ====

# Telegram 机器人 token（找 @BotFather 创建 bot 后获得）
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token

# 只允许这个 Telegram 用户指挥机器人（你的数字 chat_id）
# 获取方法：
# 1. 先用手机给你的 bot 发一条任意消息
# 2. 在电脑浏览器打开：
#    https://api.telegram.org/bot<你的TOKEN>/getUpdates
# 3. 在返回 JSON 里找："chat":{"id": 数字}
ALLOWED_CHAT_ID=123456789

# Channel: telegram (default) or feishu.  The Feishu bridge uses long
# connection mode, so a public callback URL is not required.
BOT_CHANNEL=telegram
# Create an internal app in Feishu Open Platform and enable the bot capability.
# Give it im:message, im:message:send_as_bot and im:resource permissions, then
# subscribe to im.message.receive_v1 and card.action.trigger in Event Subscriptions.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Only this Feishu user's open_id may send commands. Leave this empty on the
# first run, send the bot a message, then copy the open_id from logs/bot.log.
# Empty means nobody is authorized (safe default).
ALLOWED_FEISHU_OPEN_ID=

# 机器人默认的工作目录（Claude CLI 会在这里读写代码）
# 之后也可以通过 Telegram 的 /project 命令动态切换。
DEFAULT_PROJECT_DIR=C:/Users/wmh/Desktop/bot

# 默认监控项目列表，逗号分隔。
MONITORED_PROJECTS=C:/Users/wmh/Desktop/bot,C:/Users/wmh/Desktop/doctor-wang

# Optional project shelves. Each first-level subdirectory becomes selectable
# via /project; Claude/Codex monitoring still follows all local sessions.
PROJECTS_ROOTS=C:/Users/wmh/Desktop/dev

# 黄灯审批/追问等待超时（秒）
APPROVAL_TIMEOUT=300

# 超时默认动作：deny（安全，推荐）或 allow
APPROVAL_TIMEOUT_ACTION=deny

# Optional session-monitor tuning. Both Claude and Codex sessions are read
# locally; no rollout content is uploaded by the monitor.
CODEX_SESSIONS_DIR=C:/Users/wmh/.codex/sessions
SESSION_MONITOR_POLL_SECONDS=5

# 可选：如果你的本机 Claude CLI 依赖某种 API key / 登录态，可按你自己的环境另行配置。
# 这版机器人优先依赖本机已可用的 Claude Code CLI（claude 命令），而不是 Python SDK。

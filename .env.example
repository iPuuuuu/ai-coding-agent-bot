# ==== 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会上传 ====

# ---- 通道（二选一）----
# Channel: telegram (default) or feishu. 飞书通道使用官方长连接，
# 不需要公网 IP / Webhook。
BOT_CHANNEL=feishu

# Telegram 机器人 token（找 @BotFather 创建 bot 后获得）
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token
# 只允许这个 Telegram 用户指挥机器人（你的数字 chat_id）
ALLOWED_CHAT_ID=123456789

# 飞书企业自建应用（启用机器人能力），需要权限：
# im:message / im:message:send_as_bot / im:resource
# 事件订阅：im.message.receive_v1、card.action.trigger
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 唯一允许指挥本机器人的飞书用户 open_id（不是群 ID）。
# 首次启动留空 = 安全默认（所有人都会被拒绝），发一条消息后在 logs/bot.log
# 里找到自己的 open_id，填回这里再重启。
ALLOWED_FEISHU_OPEN_ID=

# ---- Codex 执行引擎 ----
# 沙箱模式：read-only 或 workspace-write（推荐）。
# workspace-write 允许 agent 在项目目录内读写和跑测试，项目之外只读。
CODEX_SANDBOX=workspace-write
# 可选：强制指定 Codex 模型（留空则使用 ~/.codex/config.toml 的默认配置）
CODEX_MODEL=

# ---- 项目 ----
# 机器人默认的工作目录
DEFAULT_PROJECT_DIR=/Users/a1234/ai-coding-agent-bot
# 默认监控/可切换项目，逗号分隔
MONITORED_PROJECTS=/Users/a1234/ai-coding-agent-bot,/Users/a1234/code/doctor-wang
# 项目“货架”目录：每个一级子目录都会自动成为 /project 可选项
PROJECTS_ROOTS=/Users/a1234/code

# ---- 交互 ----
# 等待你选择/回答的超时（秒）
APPROVAL_TIMEOUT=300
# 超时默认动作：deny（安全，推荐）或 allow
APPROVAL_TIMEOUT_ACTION=deny
# 长任务心跳间隔（秒），0 表示关闭；默认 120（每 2 分钟一条简短进展）
HEARTBEAT_SECONDS=120
# 会话/最近窗口记录的自动保存间隔（秒），0 表示关闭
STATE_AUTOSAVE_SECONDS=30

# ---- 本机会话监控 ----
# Codex 会话目录（一般不需要改）
CODEX_SESSIONS_DIR=/Users/a1234/.codex/sessions
# 旧 Claude 会话监控目录（Claude Hook 写出的状态文件）
SESSION_MONITOR_DIR=/Users/a1234/.claude/session-monitor
# 监控轮询间隔（秒）
SESSION_MONITOR_POLL_SECONDS=5

# 可选：本机 Claude CLI 依赖的 API key / 登录态，请按你自己的环境配置。
# 当前执行引擎是本机已安装的 Codex CLI（codex 命令）。

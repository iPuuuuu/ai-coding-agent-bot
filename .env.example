# ==== 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会上传 ====

# Telegram 机器人 token（找 @BotFather 创建 bot 后获得）
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token

# 只允许这个 Telegram 用户指挥机器人（你的数字 chat_id）
# 获取方法：
# 1. 先用手机给你的 bot 发一条任意消息
# 2. 在电脑浏览器打开：
#    https://api.telegram.org/bot<你的TOKEN>/getUpdates
# 3. 在返回 JSON 里找："chat":{"id": 数字}
ALLOWED_CHAT_ID=123456789

# 机器人默认的工作目录（Claude CLI 会在这里读写代码）
# 之后也可以通过 Telegram 的 /project 命令动态切换。
DEFAULT_PROJECT_DIR=C:/Users/wmh/Desktop/bot/workspace

# 黄灯审批/追问等待超时（秒）
APPROVAL_TIMEOUT=300

# 超时默认动作：deny（安全，推荐）或 allow
APPROVAL_TIMEOUT_ACTION=deny

# 可选：如果你的本机 Claude CLI 依赖某种 API key / 登录态，可按你自己的环境另行配置。
# 这版机器人优先依赖本机已可用的 Claude Code CLI（claude 命令），而不是 Python SDK。
